---
import { Picture } from 'astro:assets';
import portrait from '../assets/about.jpeg';
import Ipod from '../components/Ipod.astro';
import { about } from '../content/site';
---

<section class="section" id="about" aria-labelledby="about-title">
  <h2 class="section-title" id="about-title" data-thread="heading" data-morph="text">{about.heading}</h2>
  <div class="about">
    <div class="copy" data-morph="text" data-thread="copy">
      {about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="desk">
      <Ipod>
        <p class="note" data-morph="text">{about.ipodNote}</p>
      </Ipod>
      <figure class="portrait object" data-portrait data-morph="object">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[280, 560]}
          sizes="280px"
          alt={about.portraitAlt}
        />
        <canvas width="40" height="40" role="img" aria-label={about.portraitAlt}></canvas>
        <figcaption>{about.portraitCaption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  import { mountPortrait } from '../lib/pixelate/portrait';

  for (const fig of document.querySelectorAll('[data-portrait]')) {
    const img = fig.querySelector('img');
    const canvas = fig.querySelector('canvas');
    if (img && canvas) mountPortrait(img, canvas);
  }
</script>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px 64px;
    align-items: start;
  }

  .copy p {
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  /* the desk: the iPod lies next to the portrait */
  .desk {
    display: flex;
    gap: 44px;
    align-items: flex-start;
  }

  .note {
    max-width: 210px;
    margin: 18px 0 0 4px;
    line-height: 1;
    transform: rotate(-2deg);
  }

  /* ink: a polaroid, toned to the paper, with a handwritten caption; pixel: a framed 40px portrait */
  .portrait {
    flex: 0 0 280px;
    min-width: 0;
    margin: 64px 0 0;
    padding: 12px 12px 46px;
    border-radius: var(--r-paper);
    transform: rotate(2deg);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* picked up: it straightens, lifts, and its drawn thickness deepens under it */
  .portrait:hover {
    transform: translateY(-6px);
  }

  .portrait::after {
    transition: bottom 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .portrait:hover::after {
    bottom: -14px;
  }

  .portrait figcaption {
    position: absolute;
    inset: auto 0 9px;
    text-align: center;
    font: 500 var(--fs-hand) / 1 var(--hand);
    color: var(--accent);
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: sepia(0.25) saturate(0.8) contrast(0.92) brightness(1.06);
  }

  .portrait canvas {
    display: none;
    position: absolute;
    inset: 15px;
    width: calc(100% - 30px);
    height: auto;
    aspect-ratio: 1;
    image-rendering: pixelated;
  }

  :root[data-mode="pixel"] .portrait {
    padding: 15px;
    transform: none;
    transition:
      translate 0.1s steps(2),
      filter 0.1s steps(2);
  }

  /* pixel: a whole step up, the drop a step further down */
  :root[data-mode="pixel"] .portrait:hover {
    --drop: 12px;
    translate: 0 -4px;
  }

  :root[data-mode="pixel"] .portrait figcaption {
    display: none;
  }

  /* the photo keeps its box (and keeps loading) under the canvas */
  :root[data-mode="pixel"] .portrait :global(img) {
    visibility: hidden;
  }

  :root[data-mode="pixel"] .portrait canvas {
    display: block;
  }

  :root[data-mode="pixel"] .note {
    transform: none;
  }

  @media (max-width: 1100px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 980px) {
    .portrait {
      max-width: 280px;
    }
  }

  @media (max-width: 700px) {
    .section {
      padding-bottom: 0;
    }

    .desk {
      gap: 22px;
    }

    .note {
      font-size: var(--fs-hand-lg);
    }

    .portrait {
      flex: 1 1 0;
      margin-top: 40px;
    }

    :root[data-mode="pixel"] .portrait {
      max-width: 240px;
    }
  }
</style>
