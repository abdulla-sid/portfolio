---
import { player, playlist } from '../content/music';

const first = playlist[0];
---

<div class="mini" data-mini data-morph="text">
  <button class="pp object chip" type="button" aria-pressed="false" aria-label={player.play}>
    <svg viewBox="0 0 12 12" aria-hidden="true">
      <path class="play ink" d="M3 1.5v9l7.5-4.5z"></path>
      <path class="play px" d="M3 1h2v2h2v2h2v2H7v2H5v2H3z"></path>
      <path class="pause" d="M2 1h3v10H2zM7 1h3v10H7z"></path>
    </svg>
  </button>
  <span class="track" data-track>{first && player.track(first)}</span>
</div>

<script>
  import { mountMini } from '../lib/music/mini';

  for (const el of document.querySelectorAll<HTMLElement>('[data-mini]')) mountMini(el);
</script>

<style>
  .mini {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }

  .pp {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    padding: 0;
    border-radius: 50%;
    color: var(--ink);
    --object-fill: transparent;
    cursor: pointer;
    transition: scale 0.1s;
  }

  .pp:active {
    scale: 0.88;
  }

  .pp:is(:hover, :focus-visible) {
    --object-fill: var(--ink);
    color: var(--paper);
  }

  .pp svg {
    width: 11px;
    height: 11px;
    fill: currentColor;
  }

  /* one icon at a time: play (ink or pixel shape) when paused, pause when playing */
  .px,
  .pause,
  .pp[aria-pressed="true"] .play,
  :root[data-mode="pixel"] .ink {
    display: none;
  }

  .pp[aria-pressed="true"] .pause,
  :root[data-mode="pixel"] .pp:not([aria-pressed="true"]) .px {
    display: inline;
  }

  .track {
    overflow: hidden;
    max-width: 220px;
    color: var(--ink);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  :root[data-mode="pixel"] .pp {
    --object-fill: var(--card-2);
    transition: none;
  }

  :root[data-mode="pixel"] .pp svg {
    shape-rendering: crispEdges;
  }

  /* hover: a stepped block of accent, no easing */
  :root[data-mode="pixel"] .pp:is(:hover, :focus-visible) {
    --object-fill: var(--accent);
    --object-edge: var(--accent);
    color: var(--accent-ink);
  }

  /* pixel: it presses a whole step down */
  :root[data-mode="pixel"] .pp:active {
    scale: none;
    translate: 0 2px;
  }

  @media (max-width: 700px) {
    .track {
      display: none;
    }

    /* a 44px hit area around the 28px circle; ::after is the ink thickness, so ::before */
    .pp::before {
      content: "";
      position: absolute;
      inset: -9px;
    }
  }
</style>
