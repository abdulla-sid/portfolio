---
import { ipod } from '../content/ipod';

// a quarter of the ring, centred on the menu key; the other keys' quarters are it turned
const quarter = 'M5.5 5.5A16.3 16.3 0 0 1 28.5 5.5L21.4 12.6A6.2 6.2 0 0 0 12.6 12.6z';
const keys = [
  ['menu', 0],
  ['next', 90],
  ['play', 180],
  ['prev', 270],
] as const;
---

<!-- The iPod: an 80x60 LCD and a click wheel on the shared music store. The slot holds its margin note. -->
<div class="iwrap" id="ipod">
  <div class="ipod object" role="group" aria-label={ipod.label} data-morph="object">
    <i class="jack" data-thread="jack" aria-hidden="true"></i>
    <svg class="pixel-body" viewBox="0 0 200 335" aria-hidden="true">
      <path class="f" data-path="body-fill"></path>
      <path class="e" data-path="body-edge"></path>
    </svg>
    {/* role="application": it takes the arrow keys and Enter itself, and the role lets its label be read */}
    <div class="screen" role="application" tabindex="0" aria-label={ipod.screen} aria-describedby="ipod-say">
      <canvas data-lcd width="80" height="60"></canvas>
      <canvas class="cover" data-cover width="18" height="18" aria-hidden="true" hidden></canvas>
    </div>
    <div class="wheel" data-wheel>
      <svg class="ink-wheel" viewBox="0 0 34 34" aria-hidden="true">
        <circle class="ring" cx="17" cy="17" r="16.6"></circle>
        {keys.map(([k, deg]) => <path class="lit" data-lit={k} d={quarter} transform={`rotate(${deg} 17 17)`} />)}
        <circle class="hub" cx="17" cy="17" r="6.2"></circle>
        <text x="17" y="5.6" text-anchor="middle">MENU</text>
        <path d="M26.4 15.6l1.5 1.4-1.5 1.4zM28 15.6l1.5 1.4-1.5 1.4z"></path>
        <path class="bar" d="M29.9 15.6v2.8"></path>
        <path d="M7.6 15.6l-1.5 1.4 1.5 1.4zM6 15.6l-1.5 1.4 1.5 1.4z"></path>
        <path class="bar" d="M4.1 15.6v2.8"></path>
        <path d="M14.9 27.2l2 1.4-2 1.4z"></path>
        <path class="bar" d="M17.9 27.2v2.8M19.2 27.2v2.8"></path>
      </svg>
      <svg class="pixel-wheel" viewBox="0 0 136 136" aria-hidden="true">
        <path class="f" data-path="ring-fill"></path>
        <path class="e" data-path="ring-edge"></path>
        {keys.map(([k]) => <path class="lit" data-lit={k} data-path={`lit-${k}`} />)}
        <path class="hf" data-path="hub-fill"></path>
        <path class="e" data-path="hub-edge"></path>
        <path class="g" data-path="labels"></path>
      </svg>
      <button class="key menu" type="button" data-key="menu" aria-label={ipod.keys.menu}></button>
      <button class="key next" type="button" data-key="next" aria-label={ipod.keys.next}></button>
      <button class="key prev" type="button" data-key="prev" aria-label={ipod.keys.prev}></button>
      <button class="key play" type="button" data-key="play" aria-label={ipod.keys.play}></button>
      <button class="key centre" type="button" data-key="centre" aria-label={ipod.keys.centre}></button>
    </div>
  </div>
  <slot />
  <p class="visually-hidden" id="ipod-say" data-say aria-live="polite"></p>
</div>

<script>
  import { byId } from '../lib/dom';
  import { mountIpod } from '../lib/ipod/ipod';

  mountIpod(byId('ipod'));
</script>

<style>
  /* rotate the wrapper, not the body, so the drawn thickness stays behind the body */
  .iwrap {
    flex: none;
    width: 200px;
    padding-top: 14px;
    transform: rotate(-3deg);
    transform-origin: 50% 0;
  }

  .ipod {
    width: 200px;
    height: 335px;
    padding-top: 20px;
    border-radius: 28px;
  }

  .jack {
    position: absolute;
    left: 30px;
    top: -10px;
    width: 13px;
    height: 9px;
    border: var(--stroke) solid var(--ink);
    border-bottom: 0;
    border-radius: 3px 3px 0 0;
    background: var(--card);
  }

  .screen {
    position: relative;
    width: 160px;
    height: 120px;
    box-sizing: content-box;
    margin: 0 auto;
    border: var(--stroke) solid var(--ink);
    border-radius: 4px;
    background: var(--lcd-bg);
    overflow: hidden;
  }

  .screen canvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  /* the art sits where Now Playing leaves room for it: LCD pixels 3..21 across, 21..39 down */
  .screen .cover {
    position: absolute;
    left: 6px;
    top: 42px;
    width: 36px;
    height: 36px;
    box-shadow: 0 0 0 1px var(--ink);
    image-rendering: auto;
  }

  .screen .cover[hidden] {
    display: none;
  }

  .wheel {
    position: relative;
    width: 136px;
    height: 136px;
    margin: 30px auto 0;
    user-select: none;
    -webkit-user-select: none;
  }

  .wheel svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ink-wheel circle {
    stroke: var(--ink);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .ink-wheel .ring {
    fill: var(--paper);
  }

  .ink-wheel .hub {
    fill: var(--card);
    transform-origin: center;
    transform-box: fill-box;
    transition:
      fill 0.2s,
      scale 0.1s;
  }

  .ink-wheel text {
    font: 500 2.5px var(--text);
    letter-spacing: 0.12px;
    fill: var(--ink-2);
  }

  .ink-wheel path {
    fill: var(--ink-2);
  }

  .ink-wheel .bar {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .pixel-wheel,
  .pixel-body {
    display: none;
  }

  .key {
    position: absolute;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .menu,
  .play {
    left: 44px;
    width: 48px;
    height: 38px;
  }

  .menu {
    top: 2px;
  }

  .play {
    bottom: 2px;
  }

  .next,
  .prev {
    top: 44px;
    width: 38px;
    height: 48px;
  }

  .next {
    right: 2px;
  }

  .prev {
    left: 2px;
  }

  .centre {
    left: 44px;
    top: 44px;
    width: 48px;
    height: 48px;
  }

  /* the part of the ring under the pointer lights up; the centre button presses in */
  .wheel .lit {
    fill: var(--accent-soft);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .wheel:has(.menu:is(:hover, :focus-visible)) [data-lit="menu"],
  .wheel:has(.next:is(:hover, :focus-visible)) [data-lit="next"],
  .wheel:has(.prev:is(:hover, :focus-visible)) [data-lit="prev"],
  .wheel:has(.play:is(:hover, :focus-visible)) [data-lit="play"] {
    opacity: 1;
  }

  .wheel:has(.centre:is(:hover, :focus-visible)) .hub {
    fill: var(--accent-soft);
  }

  .wheel:has(.centre:active) .hub {
    scale: 0.88;
  }

  :root[data-mode="pixel"] .wheel .lit {
    transition: none;
  }

  :root[data-mode="pixel"] .wheel:has(.centre:is(:hover, :focus-visible)) .hf {
    fill: var(--accent-soft);
  }

  /* pixel: the hub drops a whole step */
  :root[data-mode="pixel"] .wheel:has(.centre:active) :is(.hf, [data-path="hub-edge"]) {
    translate: 0 2px;
  }

  /* pixel: the body and wheel are drawn as stepped shapes (lib/ipod/body.ts) instead of the shared frame */
  :root[data-mode="pixel"] .iwrap {
    transform: none;
  }

  :root[data-mode="pixel"] .iwrap .ipod {
    border-radius: 0;
    background: none;
    filter: drop-shadow(6px 6px 0 var(--shadow));
  }

  :root[data-mode="pixel"] .pixel-body {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    shape-rendering: crispEdges;
  }

  .pixel-body .f {
    fill: var(--card-2);
  }

  .pixel-body .e,
  .pixel-wheel .e {
    fill: var(--edge);
  }

  .pixel-wheel .f {
    fill: var(--hair);
  }

  .pixel-wheel .hf {
    fill: var(--card);
  }

  .pixel-wheel .g {
    fill: var(--ink-2);
  }

  :root[data-mode="pixel"] .jack {
    top: -8px;
    width: 12px;
    height: 8px;
    border: 0;
    border-radius: 0;
    background: var(--edge);
  }

  :root[data-mode="pixel"] .screen {
    border: 2px solid var(--shadow);
    border-radius: 0;
  }

  :root[data-mode="pixel"] .screen .cover {
    box-shadow: 0 0 0 2px var(--edge);
    image-rendering: pixelated;
  }

  :root[data-mode="pixel"] .wheel svg {
    shape-rendering: crispEdges;
  }

  :root[data-mode="pixel"] .ink-wheel {
    display: none;
  }

  :root[data-mode="pixel"] .pixel-wheel {
    display: block;
  }

  :root[data-mode="pixel"] .key {
    border-radius: 0;
  }

  /* phone: a smaller iPod so the portrait keeps its room */
  @media (max-width: 700px) {
    .iwrap {
      zoom: 0.8;
    }

    /* 56px hit areas (44px after the zoom): each ring key grows outward, the centre evenly; edges meet, never overlap */
    .key::before {
      content: "";
      position: absolute;
      inset: -4px;
    }

    .menu::before {
      inset: -18px -4px 0;
    }

    .play::before {
      inset: 0 -4px -18px;
    }

    .next::before {
      inset: -4px -18px -4px 0;
    }

    .prev::before {
      inset: -4px 0 -4px -18px;
    }
  }
</style>
