---
import { Image } from 'astro:assets';
import teamPhoto from '../../assets/prefetch-v-team.jpeg';
import { type Project, projectsCopy } from '../../content/projects';

interface Props {
  kind: NonNullable<Project['visual']>;
}

const { kind } = Astro.props;
---

{
  kind === 'prefetch-photo' && (
    <figure class="photo" data-morph="object">
      <Image
        src={teamPhoto}
        widths={[340, 680]}
        sizes="340px"
        alt={projectsCopy.prefetchPhoto.alt}
      />
      <figcaption>{projectsCopy.prefetchPhoto.caption}</figcaption>
    </figure>
  )
}
{
  kind === 'pipeline-drawing' && (
    <>
      <svg
        class="drawing"
        data-morph="object"
        viewBox="0 0 260 170"
        role="img"
        aria-label={projectsCopy.pipelineDrawingLabel}
      >
        <g transform="matrix(.866 .5 -.866 .5 118 64)">
          <rect width="100" height="64" rx="2" />
        </g>
        <g transform="matrix(.866 .5 -.866 .5 118 60)">
          <rect width="100" height="64" rx="2" />
        </g>
        <g transform="matrix(.866 .5 -.866 .5 124 44)">
          <rect width="100" height="64" rx="2" />
        </g>
        <g transform="matrix(.866 .5 -.866 .5 124 40)">
          <rect width="100" height="64" rx="2" />
        </g>
        <g transform="matrix(.866 .5 -.866 .5 120 24)">
          <rect width="100" height="64" rx="2" />
        </g>
        <g transform="matrix(.866 .5 -.866 .5 120 20)">
          <rect width="100" height="64" rx="2" />
          <path class="fine" d="M12 12h46M12 22h62M12 32h38" />
          <path class="mark" d="M66 40l7 7 15-16" />
        </g>
        <g transform="matrix(.866 .5 -.866 .5 200 112) rotate(-14)">
          <rect width="54" height="34" rx="2" />
          <path class="fine" d="M8 9h30M8 17h22" />
          <path class="mark" d="M4 28L50 6" />
        </g>
      </svg>
      <div class="term object" data-morph="object" role="img" aria-label={projectsCopy.pipelineDemo.label}>
        {projectsCopy.pipelineDemo.lines.map((l) => <div class={l.kind}>{l.text}</div>)}
      </div>
    </>
  )
}

<style>
  .photo {
    margin: 0;
  }

  .photo img {
    width: 100%;
    height: auto;
    border: 1px solid var(--ink);
    /* an old print in ink mode */
    filter: sepia(0.25) saturate(0.8) contrast(0.92) brightness(1.06);
  }

  .photo figcaption {
    margin-top: 8px;
    font: italic 400 var(--fs-xs)/1.3 var(--text);
    color: var(--ink-2);
  }

  .drawing {
    width: 100%;
    height: auto;
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.1;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .drawing * {
    vector-effect: non-scaling-stroke;
  }

  .drawing .fine {
    stroke-width: 0.8;
  }

  .drawing .mark {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
  }

  .term {
    display: none;
  }

  :root[data-mode="pixel"] .photo img {
    filter: none;
    border: 0;
    box-shadow: 0 0 0 3px var(--shadow);
  }

  :root[data-mode="pixel"] .photo figcaption {
    font-style: normal;
  }

  :root[data-mode="pixel"] .drawing {
    display: none;
  }

  :root[data-mode="pixel"] .term {
    --object-fill: var(--shadow);
    display: block;
    padding: 21px;
    font: 500 var(--fs-hand)/1.5 var(--mono);
    color: var(--ink-2);
  }

  .term .ok {
    color: var(--accent);
  }

  .term .ask {
    color: var(--warn);
  }

  /* two colours: the line that needs you is the accent block, not a third colour */
  :root[data-mode="pixel"] .term .ask {
    margin: 0 -6px;
    padding: 0 6px;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .term .you {
    color: var(--ink);
  }
</style>
