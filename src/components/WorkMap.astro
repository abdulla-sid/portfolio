---
import { cities, work, workCopy } from '../content/work';

/* The map frame. Whatever goes in the slot (the job card) sits on the map on wide screens; the camera keeps pins clear of it. */
const first = work[0];
---

<div class="atlas" data-work-map>
  <figure class="frame object" data-morph="object">
    <div class="map" data-map data-thread="map" role="region" aria-label={workCopy.mapLabel}>
      <p class="wait" data-map-wait data-failed={workCopy.failed}>{workCopy.loading}</p>
      {
        first && (
          <p class="city" data-map-city>
            {cities[first.pin.city].name}
            {first.citySub && <small>{first.citySub}</small>}
          </p>
        )
      }
      <svg class="reach" data-map-reach aria-hidden="true"><path></path></svg>
    </div>
    <figcaption class="caption">{workCopy.caption}</figcaption>
  </figure>
  <slot />
</div>

<script>
  import { initWorkMap } from '../lib/map/init';

  for (const el of document.querySelectorAll<HTMLElement>('[data-work-map]')) initWorkMap(el);
</script>

<style>
  .atlas {
    position: relative;
  }

  .frame {
    margin: 0;
    border-radius: var(--r-card);
    padding: 8px;
  }

  .map {
    position: relative;
    height: 540px;
    border-radius: var(--r-inset);
    overflow: hidden;
    background: var(--map-bg);
  }

  .wait {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    max-width: none;
    margin: 0;
    padding: 0 16px;
    text-align: center;
    font: italic 400 var(--fs-sm) var(--text);
    color: var(--ink-2);
  }

  .map.ready .wait {
    display: none;
  }

  .city {
    position: absolute;
    right: 22px;
    top: 14px;
    z-index: 3;
    margin: 0;
    pointer-events: none;
    font: italic 400 var(--fs-h3) / 1 var(--display);
    color: var(--ink);
    text-shadow:
      0 0 6px var(--map-bg),
      0 0 2px var(--map-bg);
  }

  .city :global(small) {
    display: block;
    text-align: right;
    font: italic 400 var(--fs-xs)/1.4 var(--text);
    color: var(--ink-2);
  }

  .reach {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .reach.on {
    opacity: 1;
  }

  .reach path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .caption {
    margin: 10px 2px 0;
    text-align: right;
    font: italic 400 var(--fs-xs) var(--text);
    color: var(--ink-2);
  }

  /* the few MapLibre rules the map needs; its own stylesheet would block rendering of the whole page */
  .map :global(.maplibregl-canvas) {
    position: absolute;
    left: 0;
    top: 0;
    outline: none;
  }

  .map :global(.maplibregl-interactive) {
    cursor: grab;
  }

  .map :global(.maplibregl-marker) {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform;
  }

  .map :global(.maplibregl-ctrl-bottom-right) {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 2px 6px;
    font: var(--fs-micro)/1.4 var(--text);
    color: var(--ink-2);
    opacity: 0.7;
  }

  .map :global(.maplibregl-ctrl-attrib a) {
    color: inherit;
  }

  .map :global(.maplibregl-ctrl-attrib-button) {
    display: none;
  }

  /* pins are made by the map script, so their rules are global within the map */
  .map :global(.pin) {
    appearance: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .map :global(.pin span) {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--paper);
    transition:
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.25s;
  }

  /* the pin under the pointer grows a little and takes the accent, and so does its label */
  .map :global(.pin:hover:not(.is-active) span) {
    background: var(--accent);
    transform: scale(1.3);
  }

  .map :global(.pin:hover:not(.is-active) em) {
    color: var(--accent);
  }

  .map :global(.pin.is-active span) {
    background: var(--accent);
    transform: scale(1.5);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }

  .map :global(.pin em) {
    position: absolute;
    left: 26px;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font: italic 400 var(--fs-xs)/1 var(--text);
    text-shadow:
      0 0 4px var(--map-bg),
      0 0 4px var(--map-bg),
      0 0 2px var(--map-bg);
  }

  /* the active label is already chosen; let taps through to pins it covers */
  .map :global(.pin.is-active em) {
    color: var(--accent);
    font-weight: 500;
    pointer-events: none;
  }

  /* the map script picks the side, clear of the frame's edges and the line */
  .map :global(.pin[data-side="left"] em) {
    left: auto;
    right: 26px;
  }

  .map :global(.pin:is([data-side="above"], [data-side="below"]) em) {
    left: 50%;
    transform: translateX(-50%);
  }

  .map :global(.pin[data-side="above"] em) {
    top: auto;
    bottom: 22px;
  }

  .map :global(.pin[data-side="below"] em) {
    top: 22px;
  }

  /* no side is clear of the line: the label sits over it on a patch of map, so the line never strikes through it */
  .map :global(.pin.over) {
    z-index: 3;
  }

  .map :global(.pin.over em) {
    padding: 2px 4px;
    background: var(--map-bg);
  }

  :root[data-mode="pixel"] .frame {
    padding: 6px;
  }

  :root[data-mode="pixel"] .map {
    border-radius: 0;
  }

  :root[data-mode="pixel"] :is(.wait, .caption, .city) {
    font-style: normal;
  }

  /* [data-mode] keeps it at --fs-h3 on a phone too */
  :root[data-mode="pixel"] .city {
    font-size: var(--fs-h3);
    font-weight: var(--display-weight);
  }

  :root[data-mode="pixel"] .city :global(small) {
    font-style: normal;
  }

  :root[data-mode="pixel"] .reach path {
    stroke-width: 3;
    stroke-linecap: square;
  }

  :root[data-mode="pixel"] .map :global(.pin span) {
    width: 10px;
    height: 10px;
    border: 0;
    border-radius: 0;
    background: var(--map-bg);
    box-shadow:
      0 0 0 2px var(--ink),
      0 0 0 4px var(--shadow);
    transition: none;
  }

  /* pixel: the hovered pin is a size step bigger, in accent */
  :root[data-mode="pixel"] .map :global(.pin:hover:not(.is-active) span) {
    width: 14px;
    height: 14px;
    transform: none;
    background: var(--accent);
  }

  :root[data-mode="pixel"] .map :global(.pin:hover:not(.is-active) em) {
    color: var(--accent);
  }

  :root[data-mode="pixel"] .map :global(.pin.is-active span) {
    width: 18px;
    height: 18px;
    transform: none;
    background: radial-gradient(var(--shadow) 0 2.5px, var(--accent) 3px);
    box-shadow:
      0 0 0 3px var(--shadow),
      5px 5px 0 var(--shadow);
  }

  :root[data-mode="pixel"] .map :global(.pin em) {
    font: 400 var(--fs-label)/1 var(--label);
    color: var(--ink-2);
  }

  :root[data-mode="pixel"] .map :global(.pin.is-active em) {
    left: 32px;
    padding: 6px 8px;
    font-weight: 400;
    color: var(--accent-ink);
    background: var(--accent);
    text-shadow: none;
    box-shadow: 3px 3px 0 var(--shadow);
  }

  @media (max-width: 700px) {
    .frame {
      padding: 6px;
    }

    .map {
      height: 290px;
    }

    .city {
      right: 12px;
      top: 10px;
      font-size: var(--fs-lead);
    }

    .caption {
      display: none;
    }
  }
</style>
