# Copy to .env for local work; on Cloudflare Pages set these in the project's settings.
# Turnstile's always-pass test keys, so the card can post locally against `wrangler pages dev`.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Only the Pages Function (functions/api/contact.ts) reads these.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
BREVO_API_KEY=
CONTACT_RECIPIENT=
CONTACT_SENDER=contact@tinydesktop.me
