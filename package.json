{
  "name": "tinydesktop",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --port 4330",
    "build": "astro build && node scripts/size-budget.mjs",
    "preview": "astro preview --port 4329",
    "check": "astro check && biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "maplibre-gl": "^6.15.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
